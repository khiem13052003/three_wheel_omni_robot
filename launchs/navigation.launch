<?xml version="1.0" ?>

<launch>
  <include file="$(find three_wheel_omni_robot)/launchs/omni_configuration.launch"/>  
  <include file="$(find three_wheel_omni_robot)/launchs/move_base.launch"/>   
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find hector_slam_launch)/rviz_cfg/mapping_demo.rviz"/>
  <node name="rosapi" pkg="rosapi" type="rosapi_node" output="screen"/>
  <arg name="port" default="9090"/>
  <arg name="address" default="0.0.0.0"/>

  <!-- Load waypoints vào parameter server -->

  <node pkg="three_wheel_omni_robot" type="js.py" name="json_service" output="screen"/>
  <!-- Start websocket server -->
  <node name="rosbridge_websocket" pkg="rosbridge_server" type="rosbridge_websocket.py" output="screen">
    <param name="port" value="$(arg port)"/>
    <param name="address" value="$(arg address)"/>
  </node>

</launch>
